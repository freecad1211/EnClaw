# Local Ollama (preferred; no API key required)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Optional OpenAI-compatible endpoint. Use a provider's documented base URL.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_API_KEY=

# Set true only after verifying this remote endpoint is genuinely free.
OPENAI_COMPAT_IS_FREE=false

# Discord control plane (never commit real token values)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_OPERATOR_IDS=
ENCLAW_PROJECTS_FILE=~/.config/enclaw/projects.json
ENCLAW_DB_PATH=~/.local/state/enclaw/tasks.sqlite3
